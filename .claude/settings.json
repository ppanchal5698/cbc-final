{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_tool_use.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "mcp__pdf-tools__*",
      "mcp__calc-engine__*",
      "mcp__artifact-storage__*",
      "mcp__p21-connector__lookup_last_po",
      "mcp__p21-connector__check_freshness",
      "mcp__p21-connector__search_item",
      "mcp__catalog__*",
      "mcp__catalog-docs__*",
      "mcp__bid-docs__*",
      "mcp__reference__*",
      "*"
    ],
    "deny": [
      "mcp__p21-connector__write_*",
      "mcp__p21-connector__update_*",
      "mcp__p21-connector__insert_*",
      "mcp__p21-connector__create_*",
      "mcp__p21-connector__delete_*",
      "mcp__p21-connector__post_*",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item *)",
      "Bash(ri *)",
      "Bash(del /s *)",
      "Bash(git push *)",
      "Bash(git push --force *)",
      "Bash(sendmail *)",
      "Bash(mailx *)",
      "Bash(curl *mail*)"
    ]
  },
  "enableAllProjectMcpServers": true
}
