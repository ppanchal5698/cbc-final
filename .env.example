# Copy to `.env` at the repo root (APIs + workers) and to `apps/web/.env.local`
# (Next.js), then fill in. `.env` is gitignored.
#
#     cp .env.example .env
#     cp .env.example apps/web/.env.local   # then keep only the Next.js block there

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local without compose: standalone is fine (leave MONGODB_TRANSACTIONS unset).
# Compose runs a single-node replica set (rs0) so multi-doc transactions work;
# multi-node HA is an ops concern, not this repo.
# Rotate MONGO_ROOT_PASSWORD before publishing ports; keep MONGODB_URI in sync.
MONGODB_URI=mongodb://cbc:cbc_local_dev@localhost:27017/cbc_opshub?authSource=admin
MONGODB_DB=cbc_opshub
MONGO_ROOT_PASSWORD=cbc_local_dev
# MONGODB_TRANSACTIONS=1
# Read-only credential for the catalog / bid-docs / catalog-docs MCP servers.
# Leave empty to derive it from MONGODB_URI; set it when the cluster owner
# provisions the read-only user instead. An explicit value always wins.
MONGODB_READONLY_URI=

# ── Paths (domain-bounded layout) ───────────────────────────────────────────
STORAGE_ROOT=./data/projects
PRICEBOOK_DIR=./data/pricebooks
# PRICEBOOK_DEV_FRESHNESS=1  # local only: edit lastReviewed to toggle fresh/stale in UI
REFERENCE_DIR=./data/reference-library
# REFERENCE_DIR is seed/fixtures only. Live pricing config lives in Mongo
# collection `referenceData` (seeded on API startup; Admin Settings CRUD).
TEMPLATES_DIR=./templates

# ── Bootstrap ───────────────────────────────────────────────────────────────
AUTO_BOOTSTRAP=1

# ── Workers ─────────────────────────────────────────────────────────────────
CLAUDE_BIN=claude
WORKER_POLL_SECONDS=5
WORKER_JOB_TIMEOUT_SECONDS=3600
WORKER_MAX_ATTEMPTS=3
WORKER_MAX_TURNS=60
WORKER_RETRY_BASE_SECONDS=30
WORKER_CONCURRENCY=1
PIPELINE_DEBOUNCE_SECONDS=60
# Optional USD caps (unset = unlimited). Checked before claim(); over-budget jobs stay queued.
# WORKER_MAX_COST_USD_PER_DAY=
# WORKER_MAX_COST_USD_PER_PROJECT=
# Soft LiteLLM gateway budget (oss profile). Set equal to WORKER_MAX_COST_USD_PER_DAY for defense in depth.
# LITELLM_MAX_BUDGET=

# Single-node rs0 in compose enables transactions. Production HA is managed Mongo /
# DocumentDB / Atlas — swap MONGODB_URI; do not expect a 3-node RS in this compose file.
# OTEL_EXPORTER_OTLP_ENDPOINT=   # optional OTLP HTTP traces; unset = no OpenTelemetry
# OTEL_SERVICE_NAME=cbc-opshub
# ── App secrets ─────────────────────────────────────────────────────────────
# Rotate APP_SECRET_KEY, INTERNAL_API_TOKEN, INTERNAL_JWT_SECRET, and AUTH_SECRET
# before publishing host ports. See docs/it_port_request.md.
APP_SECRET_KEY=cbc-local-dev-key-change-me
INTERNAL_API_TOKEN=cbc-local-dev-key-change-me
# token = static X-Internal-Token (pytest default). jwt = short-lived HS256 for audience platform.
INTERNAL_AUTH=token
INTERNAL_JWT_SECRET=cbc-local-dev-key-change-me
# INTERNAL_JWT_SECRET_PREVIOUS=
SERVICE_AUDIENCE=platform
APP_ENV=development
MAX_UPLOAD_MB=200
# Comma-separated. Include every browser origin that will load the UI.
# In production with Nginx: https://app.<MY_DOMAIN>
# Example: https://app.<MY_DOMAIN>
CORS_ORIGINS=https://app.<MY_DOMAIN>
# Host interface for the platform API publish (internal to Compose when reverse-proxied by Nginx).
API_BIND=127.0.0.1

# ── Upload malware scan ─────────────────────────────────────────────────────
# off | clamd. Compose sets clamd; leave off for local pytest without ClamAV.
MALWARE_SCAN=off
MALWARE_SCAN_REQUIRED=0
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# ── Object storage ──────────────────────────────────────────────────────────
# local (default) | s3. When s3, hydrate into STORAGE_ROOT before workers/PDF.
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── LlamaParse Cloud (document parsing; no GPU) ─────────────────────────────
# PARSER_API_KEY is the on/off switch: empty means parsing is off and Claude
# reads PDFs through pdf-tools instead. The key stays server-side — the Settings
# screen only reports whether it is set, never the value.
#
# PARSER_TIER must be cost_effective or above. `fast` is excluded deliberately:
# it returns no granular bounding boxes, and without those a priced line has no
# rectangle on a sheet to point at, which NFR-3 does not allow.
#   cost_effective   3 credits/page (+3 layout)  ≈ $0.0075/page
#   agentic         10 credits/page (+3 layout)  better on dense door schedules
#   agentic_plus    45 credits/page (+3 layout)
#
# Bid-set PDFs only. Price books and multiplier sheets are not sent to LlamaParse.
#
# PARSER_* are editable without restart (Settings screen / mounted .env).
# Compose does not interpolate them into containers; the parser worker reads .env.
#
# PARSER_API_KEY=
# PARSER_TIER=cost_effective
# PARSER_LANG=en
# PARSER_WINDOW_PAGES=8
# PARSER_WINDOW_TIMEOUT_SECONDS=1800
# PARSER_WAIT_MAX_SECONDS=1800

# ── P21 (Path 1 last-PO costs; NR-10) ───────────────────────────────────────
# Leave unset for local/dev — pricing falls through to list×multiplier / MANUAL.
# When set, pricing-engineer MUST call lookup_last_po before MANUAL cutoff.
# P21_BASE_URL=https://p21.example.com/api
# P21_API_KEY=
# P21_TIMEOUT_SECONDS=10

# ── Next.js (apps/web/.env.local) ───────────────────────────────────────────
# Compose reads NEXTAUTH_URL from this root .env. Set it to the public canonical HTTPS URL.
# In production behind Nginx:
NEXTAUTH_URL=https://app.<MY_DOMAIN>
# AUTH_SECRET=cbc-opshub-local-dev-secret-change-in-production
# AUTH_TRUST_HOST=true
# INTERNAL_AUTH=jwt
# INTERNAL_JWT_SECRET=cbc-local-dev-key-change-me
