# Container settings for medium-spec GPU (8–12 GB VRAM). Needs rebuild/restart.
#   docker compose -f infra/docker-compose.yml --env-file .env \
#     --env-file infra/mineru/medium.env --profile gpu up -d --build
MINERU_BASE_IMAGE=python:3.12-slim-bookworm
MINERU_EXTRAS=core
MINERU_MODELS=all
MINERU_GPU_COUNT=1
MINERU_API_MAX_CONCURRENT_REQUESTS=1
MINERU_PROCESSING_WINDOW_SIZE=16
MINERU_API_EXTRA_ARGS=
PARSER_WORKER_CONCURRENCY=1
MINERU_SHM_SIZE=8g
