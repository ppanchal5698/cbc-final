# Container settings for high-spec GPU (16 GB+ VRAM). Needs rebuild/restart.
#   docker compose -f infra/docker-compose.yml --env-file .env \
#     --env-file infra/mineru/high.env --profile gpu up -d --build
MINERU_BASE_IMAGE=vllm/vllm-openai:v0.21.0-cu129
MINERU_EXTRAS=core
MINERU_MODELS=all
MINERU_GPU_COUNT=1
MINERU_API_MAX_CONCURRENT_REQUESTS=2
MINERU_PROCESSING_WINDOW_SIZE=32
MINERU_API_EXTRA_ARGS=--gpu-memory-utilization 0.8
PARSER_WORKER_CONCURRENCY=2
MINERU_SHM_SIZE=16g
