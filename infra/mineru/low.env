# Container settings for low-spec GPU (4–6 GB VRAM). Needs rebuild/restart.
#   docker compose -f infra/docker-compose.yml --env-file .env \
#     --env-file infra/mineru/low.env --profile gpu up -d --build
MINERU_BASE_IMAGE=python:3.12-slim-bookworm
MINERU_EXTRAS=pipeline
MINERU_MODELS=pipeline
MINERU_GPU_COUNT=1
MINERU_API_MAX_CONCURRENT_REQUESTS=1
MINERU_PROCESSING_WINDOW_SIZE=8
# Optional: uncomment if pipeline OOMs at 4 GB VRAM (also drop window to 4).
# MINERU_VIRTUAL_VRAM_SIZE=3
MINERU_API_EXTRA_ARGS=
PARSER_WORKER_CONCURRENCY=1
MINERU_SHM_SIZE=4g
