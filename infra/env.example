# docker compose's environment: copy to infra/.env (next to docker-compose.yml).
#
# Compose reads this file, not the root .env, to fill the ${...} values in
# docker-compose.yml - every container setting below. Everything is optional:
# left out, the local-development default shown is used, which is what
# `docker compose up` runs on with no setup.
#
# The platform refuses to start with APP_ENV=production (or staging) while any
# secret still holds its dev default. Generate secrets with:
#   openssl rand -base64 32

# APP_ENV=development
# CORS_ORIGINS=https://app.<MY_DOMAIN>
# MAX_UPLOAD_MB=200

# ── Secrets ──────────────────────────────────────────────────────────────────
# APP_SECRET_KEY=cbc-local-dev-key-change-me
# AUTH_SECRET=cbc-opshub-local-dev-secret-change-in-production
# INTERNAL_AUTH=jwt
# INTERNAL_JWT_SECRET=cbc-local-dev-key-change-me
# INTERNAL_JWT_SECRET_PREVIOUS=
# INTERNAL_API_TOKEN=cbc-local-dev-key-change-me
# AUTH_URL=http://localhost
# NEXTAUTH_URL=

# ── Database: DocumentDB Local ───────────────────────────────────────────────
# MONGO_ROOT_PASSWORD=cbc_local_dev
# MONGODB_READONLY_PASSWORD=cbc_catalog_ro_local_dev
# MONGODB_URI=                     # empty = the documentdb container
# MONGODB_READONLY_URI=
# MONGODB_TRANSACTIONS=1

# ── Memory graph: Neo4j ──────────────────────────────────────────────────────
# NEO4J_PASSWORD=cbc_graph_local_dev   # also the neo4j container's own password
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

# ── Blob Storage and Key Vault: Floci ────────────────────────────────────────
# STORAGE_BACKEND=azure
# AZURE_STORAGE_CONNECTION_STRING=     # empty = the floci container
# AZURE_STORAGE_CONTAINER=cbc
# KEY_VAULT_URL=                       # empty = the floci container's vault
# AZURE_EMULATOR_CA_URL=https://floci:4577/_floci/tls-cert
# AZURE_EMULATOR_CA=/tmp/azure-emulator-ca.pem

# ── Upload malware scan ──────────────────────────────────────────────────────
# MALWARE_SCAN=clamd                   # clamd | off
# MALWARE_SCAN_REQUIRED=0
# CLAMD_HOST=clamav
# CLAMD_PORT=3310

# ── Worker ───────────────────────────────────────────────────────────────────
# WORKER_CONCURRENCY=1
# WORKER_POLL_SECONDS=5
# WORKER_JOB_TIMEOUT_SECONDS=3600
# WORKER_MAX_TURNS=60
# WORKER_PIPELINE_TIMEOUT_SECONDS=10800
# WORKER_PIPELINE_MAX_TURNS=200
# WORKER_WAVE_LEG_MAX_TURNS=80
# WORKER_MAX_ATTEMPTS=3
# PARSER_WORKER_CONCURRENCY=1
# CLAUDE_SANDBOX=process               # process | docker
# CBC_SANDBOX_NETWORK=cbc-final-llm
# ALERT_WEBHOOK_URL=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── litellm gateway (profile "oss") ──────────────────────────────────────────
# LITELLM_MASTER_KEY=sk-cbc-local-dev
# LITELLM_MAX_BUDGET=
# OPENROUTER_API_KEY=
# NVIDIA_NIM_API_KEY=
# NIM_RPM=40
