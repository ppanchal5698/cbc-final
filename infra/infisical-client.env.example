# Infisical CLIENT credentials — infra/infisical-client.env
#
# Copy to infra/infisical-client.env and fill in. Gitignored.
#
#   cp infra/infisical-client.env.example infra/infisical-client.env
#
# Read by platform, worker and parser. infra/docker/entrypoint.sh uses it to
# re-exec under `infisical run`, so every secret arrives as process environment.
#
# Leave INFISICAL_PROJECT_ID empty (or delete this file) and nothing changes:
# the entrypoint skips injection and secrets come from the repo-root .env, which
# is how the stack ran before Infisical existed.
#
# Setup steps are in docs/operations/secrets.md.

# The self-hosted instance, on the compose network.
INFISICAL_API_URL=http://infisical:8080

# From the Infisical UI: Project → Settings → Project ID.
INFISICAL_PROJECT_ID=

# The environment slug within that project — dev / staging / prod.
INFISICAL_ENV_SLUG=prod

# Folder to read. `/` with the entrypoint's --recursive takes the whole project.
INFISICAL_SECRET_PATH=/

# Machine identity, Universal Auth. Create under
# Organization → Access Control → Identities, then grant it read access to the
# project above. A client secret is shown once.
#
# Give it read-only. It is mounted into three containers; anything it can write,
# a compromised worker can write.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# Alternative to the identity pair: a pre-minted token, if you mint it outside.
# INFISICAL_TOKEN=
