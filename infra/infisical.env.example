# Infisical SERVER bootstrap — infra/infisical.env
#
# Copy to infra/infisical.env and fill in. Gitignored; never commit the real one.
#
#   cp infra/infisical.env.example infra/infisical.env
#
# These are the credentials Infisical itself needs, so they cannot live inside
# Infisical. They are the one irreducible bootstrap secret a secrets manager
# leaves you with — the point is that it is ONE, not forty.
#
# This file is read only by the infisical/infisical-db/infisical-redis services.
# The app's own machine identity lives in infisical-client.env, separately: the
# container guarding every credential has no business holding the application's.

# Master key for the secret store, and the session signing secret. Generate both
# fresh — the values in Infisical's published .env.example are public, and a
# store encrypted with a public key is not encrypted.
#
#   openssl rand -hex 16      # ENCRYPTION_KEY  (32 hex chars)
#   openssl rand -base64 32   # AUTH_SECRET
#
# On Windows without openssl, PowerShell:
#   -join ((1..16 | % { '{0:x2}' -f (Get-Random -Max 256) }))
#   [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
#
# Changing ENCRYPTION_KEY after secrets exist makes them unreadable. Back it up
# somewhere that is not this stack.
ENCRYPTION_KEY=
AUTH_SECRET=

# Postgres. Compose also reads these for the DB container and the connection URI.
INFISICAL_DB_USER=infisical
INFISICAL_DB_PASSWORD=
INFISICAL_DB_NAME=infisical

# Where browsers reach the UI. Must match what you actually type, or the
# sign-in redirect lands nowhere.
INFISICAL_SITE_URL=http://localhost:8080
INFISICAL_PORT=8080

# Infisical phones home unless this is false.
INFISICAL_TELEMETRY_ENABLED=false
